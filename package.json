{
  "name": "@profullstack/langchain-c0mpute",
  "version": "0.1.0",
  "description": "LangChain.js chat model for c0mpute: open-weight models on a peer-to-peer compute network, priced by sealed-bid auction.",
  "license": "MIT",
  "author": "Profullstack, Inc. <hello@c0mpute.com>",
  "homepage": "https://github.com/profullstack/langchain-c0mpute#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/profullstack/langchain-c0mpute.git"
  },
  "bugs": {
    "url": "https://github.com/profullstack/langchain-c0mpute/issues"
  },
  "keywords": [
    "langchain",
    "langchainjs",
    "chat-model",
    "c0mpute",
    "llm",
    "open-weight",
    "decentralized",
    "p2p",
    "openai-compatible"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:live": "C0MPUTE_LIVE=1 vitest run test/live.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@langchain/openai": "^1.8.5"
  },
  "peerDependencies": {
    "@langchain/core": "^1.5.0"
  },
  "devDependencies": {
    "@langchain/core": "^1.5.0",
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
